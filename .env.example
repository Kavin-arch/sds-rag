EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_KEEP_ALIVE=5m
ENABLE_QUERY_EXPANSION=false

# Optional Gemini embeddings/answer provider. Ollama is the local default.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Optional hosted open-weight answer models via OpenRouter. No model weights are downloaded locally.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=300
# Optional model ID overrides
OPENROUTER_QWEN_MODEL=qwen/qwen3-235b-a22b-2507
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-r1
