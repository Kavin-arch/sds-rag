GEMINI_API_KEY=replace_with_your_gemini_api_key
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional hosted open-weight answer models via OpenRouter. No model weights are downloaded locally.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=300
# Optional model ID overrides
OPENROUTER_QWEN_MODEL=qwen/qwen3-235b-a22b-2507
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-r1
